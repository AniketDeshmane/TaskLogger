<Window x:Class="TaskLogger.Views.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Task Logger - Debug Log Viewer" 
        Height="600" 
        Width="900"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <materialDesign:ColorZone Grid.Row="0" Mode="PrimaryMid" Padding="16">
            <StackPanel>
                <TextBlock Text="Debug Log Viewer" 
                           Style="{StaticResource MaterialDesignHeadlineSmallTextBlock}"
                           Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"/>
                <TextBlock x:Name="LogFilePathText" 
                           Style="{StaticResource MaterialDesignBodySmallTextBlock}"
                           Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </materialDesign:ColorZone>

        <!-- Log Content -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Filter Controls -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <ComboBox x:Name="LogLevelFilter" Width="100" Margin="0,0,10,0"
                          materialDesign:HintAssist.Hint="Level">
                    <ComboBoxItem Content="All" IsSelected="True"/>
                    <ComboBoxItem Content="DEBUG"/>
                    <ComboBoxItem Content="INFO"/>
                    <ComboBoxItem Content="WARN"/>
                    <ComboBoxItem Content="ERROR"/>
                    <ComboBoxItem Content="FATAL"/>
                </ComboBox>

                <TextBox x:Name="SearchBox" Width="200" Margin="0,0,10,0"
                         materialDesign:HintAssist.Hint="Search logs..."
                         VerticalAlignment="Center"/>

                <Button Style="{StaticResource MaterialDesignRaisedButton}"
                        Click="RefreshButton_Click" 
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh"/>
                        <TextBlock Text="Refresh" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource MaterialDesignFlatButton}"
                        Click="ClearFilterButton_Click"
                        Margin="0,0,10,0">
                    Clear Filter
                </Button>

                <CheckBox x:Name="AutoRefreshCheckBox" Content="Auto-refresh (5s)" 
                          VerticalAlignment="Center" Margin="10,0,0,0"
                          Checked="AutoRefreshCheckBox_Checked"
                          Unchecked="AutoRefreshCheckBox_Unchecked"/>
            </StackPanel>

            <!-- Log Display -->
            <materialDesign:Card Grid.Row="1" Padding="10">
                <ScrollViewer x:Name="LogScrollViewer" 
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <TextBox x:Name="LogTextBox" 
                             IsReadOnly="True" 
                             FontFamily="Consolas" 
                             FontSize="12"
                             Background="Transparent"
                             BorderThickness="0"
                             TextWrapping="NoWrap"
                             AcceptsReturn="True"/>
                </ScrollViewer>
            </materialDesign:Card>
        </Grid>

        <!-- Status Bar -->
        <materialDesign:ColorZone Grid.Row="2" Mode="Light">
            <Grid Margin="10,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="StatusText" 
                           VerticalAlignment="Center"
                           Style="{StaticResource MaterialDesignBodyMediumTextBlock}"/>

                <Button Grid.Column="1" 
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Click="OpenLogFolderButton_Click"
                        Margin="5,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FolderOpen"/>
                        <TextBlock Text="Open Folder" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Click="CloseButton_Click">
                    Close
                </Button>
            </Grid>
        </materialDesign:ColorZone>
    </Grid>
</Window>