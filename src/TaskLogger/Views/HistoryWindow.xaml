<Window x:Class="TaskLogger.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Task History" 
        Height="600" 
        Width="800"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" 
                   Text="📋 Task History" 
                   Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,16"/>

        <!-- History Content -->
        <materialDesign:Card Grid.Row="1" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search/Filter -->
                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Width="200"
                                 materialDesign:HintAssist.Hint="Search"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="Clear" 
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Command="{Binding ClearSearchCommand}"
                                Margin="10,0,0,0"/>
                        <CheckBox Content="Current Month" 
                                  IsChecked="{Binding FilterByCurrentMonth}"
                                  Margin="10,0,0,0"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding TaskCountText}" 
                               Style="{StaticResource MaterialDesignCaptionTextBlock}"/>
                </StackPanel>

                <!-- History List -->
                <ListView Grid.Row="1" ItemsSource="{Binding Tasks}" HorizontalContentAlignment="Stretch">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <materialDesign:Card Margin="0,5" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                            <TextBlock Text="{Binding Timestamp}" 
                                                       Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                                       Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                            <TextBlock Text="{Binding EventType, StringFormat=' [{0}]'}"
                                                       Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                       Foreground="{DynamicResource SecondaryHueMidBrush}"
                                                       Visibility="{Binding EventType, Converter={StaticResource StringToVisibilityConverter}}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Task}" 
                                                   Style="{StaticResource MaterialDesignBody1TextBlock}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding IsEditing, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                        <TextBox Text="{Binding Task, UpdateSourceTrigger=PropertyChanged}" 
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 Margin="0,0,0,5"/>
                                        <TextBlock Text="{Binding Notes}" 
                                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                   FontStyle="Italic"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,0,0"
                                                   Visibility="{Binding Notes, Converter={StaticResource StringToVisibilityConverter}}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
                                        <Button Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                                ToolTip="Edit"
                                                Click="EditButton_Click"
                                                Tag="{Binding}"
                                                Visibility="{Binding IsEditing, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                            <materialDesign:PackIcon Kind="Pencil"/>
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                                ToolTip="Save"
                                                Click="SaveButton_Click"
                                                Tag="{Binding}"
                                                Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Background="{DynamicResource MaterialDesignPositiveFeedbackBrush}">
                                            <materialDesign:PackIcon Kind="ContentSave"/>
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                                ToolTip="Cancel"
                                                Click="CancelButton_Click"
                                                Tag="{Binding}"
                                                Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Background="{DynamicResource MaterialDesignPaperBrush}">
                                            <materialDesign:PackIcon Kind="Cancel" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                                ToolTip="Delete"
                                                Click="DeleteButton_Click"
                                                Tag="{Binding}"
                                                Background="{DynamicResource MaterialDesignErrorBrush}">
                                            <materialDesign:PackIcon Kind="Delete"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </materialDesign:Card>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </materialDesign:Card>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" 
                   HorizontalAlignment="Right" 
                   Margin="0,16,0,0">
            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                    Command="{Binding ExportCommand}"
                    Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Export"/>
                    <TextBlock Text="Export" Margin="8,0,0,0"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource MaterialDesignFlatButton}"
                    Click="CloseButton_Click">
                Close
            </Button>
        </StackPanel>
    </Grid>
</Window>
