<Window x:Class="TaskLogger.Views.DatabaseConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Database Configuration" 
        Height="Auto" 
        Width="600"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="🗄️ Database Configuration" 
                   Style="{StaticResource MaterialDesignHeadlineMediumTextBlock}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,16"/>

        <!-- Configuration Content -->
        <materialDesign:Card Grid.Row="1" Padding="16">
            <StackPanel>
                <TextBlock Text="Choose where to store your task data" 
                           Style="{StaticResource MaterialDesignTitleMediumTextBlock}"
                           Margin="0,0,0,15"/>

                <!-- Database Path Input -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" 
                             x:Name="DatabasePathTextBox" 
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding DatabasePath, Mode=OneWay}"
                             materialDesign:HintAssist.Hint="Database File Path"
                             Margin="0,0,10,0"/>
                    <Button Grid.Column="1" 
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Click="BrowseButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderSearch"/>
                            <TextBlock Text="Browse" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" 
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Click="LoadButton_Click"
                            Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DatabaseImport"/>
                            <TextBlock Text="Load Existing" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Path Validation -->
                <materialDesign:Card Background="{Binding PathValidationBrush}"
                                     Padding="10" 
                                     Margin="0,0,0,15">
                    <TextBlock Text="{Binding PathValidationMessage}" 
                               Foreground="{Binding PathValidationTextBrush}"
                               TextWrapping="Wrap"/>
                </materialDesign:Card>

                <!-- Options -->
                <GroupBox Header="Options"
                          Style="{StaticResource MaterialDesignGroupBox}"
                          Margin="0,0,0,15">
                    <StackPanel Margin="10">
                        <CheckBox x:Name="CreateBackupCheckBox" 
                                 Content="Create backup of existing database (if found)"
                                 IsChecked="True"/>
                        <TextBlock Text="Automatically backup your existing task data before moving" 
                                   Style="{StaticResource MaterialDesignBodySmallTextBlock}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>

                <!-- Migration Info -->
                <materialDesign:Card Padding="10"
                                     Background="{DynamicResource MaterialDesignInformationBrush}">
                    <StackPanel>
                        <TextBlock Text="ℹ️ Migration Information" 
                                   Style="{StaticResource MaterialDesignTitleSmallTextBlock}"
                                   Foreground="{DynamicResource MaterialDesignInformationForegroundBrush}"
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="If you have existing task data, it will be automatically migrated to the new location. The original database will be backed up for safety." 
                                   Style="{StaticResource MaterialDesignBodyMediumTextBlock}"
                                   Foreground="{DynamicResource MaterialDesignInformationForegroundBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>
        </materialDesign:Card>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" 
                   HorizontalAlignment="Right" 
                   Margin="0,16,0,0">
            <Button x:Name="UseDefaultButton" 
                   Style="{StaticResource MaterialDesignFlatButton}"
                   Click="UseDefaultButton_Click"
                   Margin="0,0,10,0">
                Use Default
            </Button>
            <Button x:Name="SaveButton" 
                   Style="{StaticResource MaterialDesignRaisedButton}"
                   Click="SaveButton_Click"
                   Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ContentSave"/>
                    <TextBlock Text="Save &amp; Continue" Margin="8,0,0,0"/>
                </StackPanel>
            </Button>
            <Button x:Name="CancelButton" 
                   Style="{StaticResource MaterialDesignFlatButton}"
                   Click="CancelButton_Click">
                Cancel
            </Button>
        </StackPanel>
    </Grid>
</Window>
