<Window x:Class="TaskLogger.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Task Logger"
        Height="550"
        Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        WindowStyle="SingleBorderWindow"
        StateChanged="MainWindow_StateChanged"
        Closing="MainWindow_Closing">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="📝 Task Logger"
                   Style="{StaticResource MaterialDesignHeadlineMediumTextBlock}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,16" />

        <!-- Main Content -->
        <materialDesign:Card Grid.Row="1"
                             Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Date Display -->
                <StackPanel Grid.Row="0"
                            Margin="0,0,0,16"
                            HorizontalAlignment="Center">
                    <TextBlock Text="{Binding DateText}"
                               Style="{StaticResource MaterialDesignTitleMediumTextBlock}" />
                    <TextBlock Text="It's the weekend! Take a break and enjoy your time off! 🎉"
                               Visibility="{Binding IsWeekend, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Style="{StaticResource MaterialDesignBodySmallTextBlock}"
                               Foreground="{DynamicResource MaterialDesignErrorBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- Task Input -->
                <TextBox Grid.Row="1"
                         x:Name="TaskTextBox"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         MinHeight="120"
                         materialDesign:HintAssist.Hint="What did you accomplish today?"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Text="{Binding TaskText, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="TaskTextBox_KeyDown" />

                <!-- Buttons -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,16,0,0">
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding SaveTaskCommand}"
                            Margin="0,0,8,0"
                            ToolTip="Save Task">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave" />
                            <TextBlock Text="Save" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding ViewHistoryCommand}"
                            Margin="0,0,8,0"
                            ToolTip="View History">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="History" />
                            <TextBlock Text="History" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTip="Settings">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Settings" />
                            <TextBlock Text="Settings" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                           Click="DebugLogsButton_Click"
                           ToolTip="View application debug logs" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Bug" />
                            <TextBlock Text="Logs" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- Status Bar -->
        <materialDesign:Card Grid.Row="2"
                             Padding="10,4"
                             Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Ellipse Width="8"
                         Height="8"
                         Fill="{Binding IsStatusSuccess, Converter={StaticResource BoolToColorConverter}}"
                         Margin="0,0,8,0" />
                <TextBlock Text="{Binding StatusText}"
                           Style="{StaticResource MaterialDesignBodyMediumTextBlock}"
                           Opacity="0.6" />
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</Window>
