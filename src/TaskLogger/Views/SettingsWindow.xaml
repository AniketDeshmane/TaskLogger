<Window x:Class="TaskLogger.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Settings" 
        Height="Auto" 
        Width="500"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="⚙️ Settings" 
                   Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,16"/>

        <!-- Settings Content -->
        <materialDesign:Card Grid.Row="1" Padding="16">
            <StackPanel>
                <!-- Theme Settings -->
                <GroupBox Header="Theme Settings"
                          Style="{StaticResource MaterialDesignGroupBox}"
                          Margin="0,0,0,16">
                    <StackPanel Margin="10">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="Light"
                                       VerticalAlignment="Center"/>
                            <ToggleButton Margin="10,0"
                                          IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"/>
                            <TextBlock Text="Dark"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
                
                <!-- Startup Settings -->
                <GroupBox Header="Startup Settings" 
                          Style="{StaticResource MaterialDesignGroupBox}"
                          Margin="0,0,0,16">
                    <StackPanel Margin="10">
                        <CheckBox Content="Start Task Logger with Windows"
                                  IsChecked="{Binding IsStartupEnabled, Mode=TwoWay}"/>
                        <TextBlock Text="Automatically launch Task Logger when Windows starts" 
                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>

                <!-- Notification Settings -->
                <GroupBox Header="Notification Settings" 
                          Style="{StaticResource MaterialDesignGroupBox}"
                          Margin="0,0,0,16">
                    <StackPanel Margin="10">
                        <CheckBox Content="Show weekend notifications"
                                  IsChecked="{Binding ShowWeekendNotifications, Mode=TwoWay}"/>
                        <TextBlock Text="Display friendly weekend messages when logging is disabled" 
                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>

                <!-- Data Settings -->
                <GroupBox Header="Data Settings" 
                          Style="{StaticResource MaterialDesignGroupBox}">
                    <StackPanel Margin="10">
                        <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 IsReadOnly="True"
                                 Text="{Binding LogFilePath}"
                                 materialDesign:HintAssist.Hint="Database location"
                                 Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                    Command="{Binding OpenLogFolderCommand}"
                                    Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Folder"/>
                                    <TextBlock Text="Open Folder" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                    Command="{Binding ChangeDatabaseLocationCommand}"
                                    Background="{DynamicResource MaterialDesignAccentBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="DatabaseEdit"/>
                                    <TextBlock Text="Change" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </materialDesign:Card>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" 
                   HorizontalAlignment="Right" 
                   Margin="0,16,0,0">
            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                    Command="{Binding SaveSettingsCommand}"
                    Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ContentSave"/>
                    <TextBlock Text="Save" Margin="8,0,0,0"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource MaterialDesignFlatButton}"
                    Click="CancelButton_Click">
                Cancel
            </Button>
        </StackPanel>
    </Grid>
</Window>
