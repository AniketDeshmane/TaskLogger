<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <UI>
      <!-- Default properties for custom dialogs -->
      <Property Id="LAUNCHAPP" Value="1" />
      <Property Id="AUTOSTART" Value="0" />
      <Property Id="INSTALLDESKTOPSHORTCUT" Value="1" />
      <Property Id="EXISTINGDBPATH" Secure="yes" />
      
      <!-- ===== Custom Dialogs ===== -->
      
      <!-- Database Location Dialog (two path selectors) -->
      <Dialog Id="DatabaseLocationDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="&amp;Next">
          <Publish Event="NewDialog" Value="StartupDlg" Condition="1" />
        </Control>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&amp;Back">
          <Publish Event="NewDialog" Value="InstallDirDlg" Condition="1" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" Condition="1" />
        </Control>
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="[BannerBitmap]" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes">
          <Text Value="Choose where to store your task database" />
        </Control>
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes">
          <Text Value="{\WixUI_Font_Title}Database Location" />
        </Control>
        
        <!-- Section 1: Use an existing database file -->
        <Control Id="ExistingDbLabel" Type="Text" X="20" Y="56" Width="330" Height="12" NoPrefix="yes">
          <Text Value="Use an &amp;existing database file (optional):" />
        </Control>
        <Control Id="ExistingDbPath" Type="Edit" X="20" Y="70" Width="330" Height="18" Property="EXISTINGDBPATH" />
        <Control Id="ExistingDbHint" Type="Text" X="20" Y="92" Width="330" Height="18" NoPrefix="yes">
          <Text Value="Enter the full path to an existing .db file to import your data (e.g. C:\Backup\TaskLogger.db)." />
        </Control>
        
        <!-- Separator -->
        <Control Id="SeparatorLine" Type="Line" X="20" Y="116" Width="330" Height="0" />
        
        <!-- Section 2: Save new database to location -->
        <Control Id="NewDbLabel" Type="Text" X="20" Y="124" Width="330" Height="12" NoPrefix="yes">
          <Text Value="&amp;Save new database to:" />
        </Control>
        <Control Id="NewDbFolder" Type="PathEdit" X="20" Y="138" Width="265" Height="18" Property="DATABASEFOLDER" />
        <Control Id="BrowseNewDb" Type="PushButton" X="290" Y="138" Width="65" Height="18" Text="&amp;Browse...">
          <Publish Property="_BrowseProperty" Value="DATABASEFOLDER" Order="1" Condition="1" />
          <Publish Event="SpawnDialog" Value="BrowseDlg" Order="2" Condition="1" />
        </Control>
        
        <!-- Info text -->
        <Control Id="InfoText" Type="Text" X="20" Y="166" Width="330" Height="50" NoPrefix="yes">
          <Text Value="If you have an existing database, enter its full path above to continue using your data. Otherwise, a new database will be created at the folder below. Default location is your Documents folder." />
        </Control>
      </Dialog>
      
      <!-- Startup Dialog -->
      <Dialog Id="StartupDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="&amp;Next">
          <Publish Event="NewDialog" Value="VerifyReadyDlg" Condition="1" />
        </Control>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&amp;Back">
          <Publish Event="NewDialog" Value="DatabaseLocationDlg" Condition="1" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" Condition="1" />
        </Control>
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="[BannerBitmap]" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes">
          <Text Value="Would you like Task Logger to start automatically with Windows?" />
        </Control>
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes">
          <Text Value="{\WixUI_Font_Title}Windows Startup" />
        </Control>
        
        <Control Id="AutoStartCheckBox" Type="CheckBox" X="20" Y="80" Width="330" Height="18" CheckBoxValue="1" Property="AUTOSTART">
          <Text Value="&amp;Start Task Logger when Windows starts" />
        </Control>
        
        <Control Id="DesktopShortcutCheckBox" Type="CheckBox" X="20" Y="110" Width="330" Height="18" CheckBoxValue="1" Property="INSTALLDESKTOPSHORTCUT">
          <Text Value="Create a &amp;desktop shortcut" />
        </Control>
        
        <Control Id="LaunchCheckBox" Type="CheckBox" X="20" Y="140" Width="330" Height="18" CheckBoxValue="1" Property="LAUNCHAPP">
          <Text Value="&amp;Launch Task Logger when installation completes" />
        </Control>
        
        <Control Id="InfoText" Type="Text" X="20" Y="180" Width="330" Height="40" NoPrefix="yes">
          <Text Value="You can change these settings later from within the application's Settings menu." />
        </Control>
      </Dialog>
      
      <!-- ===== Navigation Overrides for Standard WixUI_InstallDir Dialogs ===== -->
      
      <!-- Override: InstallDirDlg Next -> DatabaseLocationDlg (instead of VerifyReadyDlg) -->
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="DatabaseLocationDlg" Condition="1" Order="5" />
      
      <!-- Override: VerifyReadyDlg Back -> StartupDlg (instead of InstallDirDlg) -->
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="StartupDlg" Condition="1" Order="5" />
      
      <!-- Override: ExitDialog Finish -> Launch application before closing -->
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication" Condition="LAUNCHAPP = &quot;1&quot;" Order="1" />
    </UI>
  </Fragment>
</Wix>
