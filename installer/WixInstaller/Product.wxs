<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  
  <!-- Product Information -->
  <Package Name="Task Logger" 
           Manufacturer="TaskLogger Team"
           Version="1.0.1.0"
           UpgradeCode="E8F3C3D7-3B2F-4D2A-9C8A-3A3C2A9C8A3C"
           Scope="perMachine"
           InstallerVersion="500"
           Compressed="yes">
    
    <WixVariable Id="WixUIDialogBmp" Value="dialog.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="banner.bmp" />
    
    <!-- Package Details -->
    <SummaryInformation 
      Description="Task Logger - Professional Task Management Application"
      Manufacturer="TaskLogger Team"
      Keywords="Task,Logger,Productivity,Windows" />
    
    <!-- Media for installation files -->
    <Media Id="1" Cabinet="TaskLogger.cab" EmbedCab="yes" />
    
    <!-- Icon for Add/Remove Programs -->
    <Icon Id="TaskLoggerIcon" SourceFile="..\..\src\TaskLogger\TaskLogger.ico" />
    <Property Id="ARPPRODUCTICON" Value="TaskLoggerIcon" />
    
    <!-- Major Upgrade handling -->
    <MajorUpgrade 
      DowngradeErrorMessage="A newer version of [ProductName] is already installed."
      AllowSameVersionUpgrades="no" 
      Schedule="afterInstallInitialize" />
    
    <!-- Standard WixUI with InstallDir dialog set (provides all standard dialogs and resources) -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    
    <!-- Custom Action to launch app after install -->
    <CustomAction Id="LaunchApplication" FileRef="TaskLoggerExe" ExeCommand="" Return="asyncNoWait" Impersonate="yes" />
    
    <!-- Installation Directory Structure -->
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Task Logger">
        
        <!-- Main Application Files -->
        <Component Id="MainExecutable" Guid="*">
          <File Id="TaskLoggerExe" Source="..\..\build\output\publish\TaskLogger.exe" KeyPath="yes" />
          
          <!-- Registry entries for app paths -->
          <RegistryValue Root="HKLM"
                         Key="SOFTWARE\TaskLogger"
                         Name="InstallPath"
                         Type="string"
                         Value="[INSTALLFOLDER]" />
        </Component>
        
        <!-- PDB file for debugging (optional) -->
        <Component Id="DebugSymbols" Guid="*">
          <File Id="TaskLoggerPdb" Source="..\..\build\output\publish\TaskLogger.pdb" />
        </Component>
        
        <!-- Store database path and existing DB path in registry -->
        <Component Id="DatabasePathRegistry" Guid="*">
          <RegistryValue Root="HKLM"
                         Key="SOFTWARE\TaskLogger"
                         Name="DatabaseFolder"
                         Type="string"
                         Value="[DATABASEFOLDER]"
                         KeyPath="yes" />
          <RegistryValue Root="HKLM"
                         Key="SOFTWARE\TaskLogger"
                         Name="ExistingDatabasePath"
                         Type="string"
                         Value="[EXISTINGDBPATH]" />
        </Component>
        
        <!-- Auto-start registry entry (conditional on AUTOSTART) -->
        <Component Id="AutoStartEntry" Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567890" Condition="AUTOSTART = &quot;1&quot;">
          <RegistryValue Root="HKCU"
                         Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run"
                         Name="TaskLogger"
                         Type="string"
                         Value="&quot;[INSTALLFOLDER]TaskLogger.exe&quot;"
                         KeyPath="yes" />
        </Component>
        
        <!-- Per-user registry cleanup on uninstall -->
        <Component Id="CleanupUserRegistry" Guid="B2C3D4E5-F6A7-8901-BCDE-F12345678901">
          <RegistryValue Root="HKCU"
                         Key="SOFTWARE\TaskLogger\Cleanup"
                         Name="RegistryMarker"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
          <RemoveRegistryKey Id="RemoveTaskLoggerUserKey" Root="HKCU" Key="SOFTWARE\TaskLogger" Action="removeOnUninstall" />
        </Component>
      </Directory>
    </StandardDirectory>
    
    <!-- Database default directory (Documents\TaskLogger) -->
    <StandardDirectory Id="PersonalFolder">
      <Directory Id="DATABASEFOLDER" Name="TaskLogger">
        <!-- Cleanup Documents\TaskLogger on uninstall -->
        <Component Id="CleanupDocuments" Guid="C3D4E5F6-A7B8-9012-CDEF-123456789012">
          <RegistryValue Root="HKCU"
                         Key="SOFTWARE\TaskLogger\Cleanup"
                         Name="DocumentsMarker"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
          <RemoveFile Id="RemoveDocAllFiles" On="uninstall" Name="*" />
          <RemoveFolder Id="RemoveDocumentsDir" On="uninstall" />
        </Component>
      </Directory>
    </StandardDirectory>
    
    <!-- AppData cleanup directories -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="TaskLoggerAppDataDir" Name="TaskLogger">
        <!-- Cleanup AppData\Local\TaskLogger files on uninstall -->
        <Component Id="CleanupAppData" Guid="D4E5F6A7-B8C9-0123-DEFA-234567890123">
          <RegistryValue Root="HKCU"
                         Key="SOFTWARE\TaskLogger\Cleanup"
                         Name="AppDataMarker"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
          <RemoveFile Id="RemoveAppDataAllFiles" On="uninstall" Name="*" />
          <RemoveFolder Id="RemoveAppDataDir" On="uninstall" />
        </Component>
        
        <Directory Id="TaskLoggerLogsDir" Name="Logs">
          <!-- Cleanup Logs subdirectory on uninstall -->
          <Component Id="CleanupLogs" Guid="E5F6A7B8-C9D0-1234-EFAB-345678901234">
            <RegistryValue Root="HKCU"
                           Key="SOFTWARE\TaskLogger\Cleanup"
                           Name="LogsMarker"
                           Type="integer"
                           Value="1"
                           KeyPath="yes" />
            <RemoveFile Id="RemoveAllLogFiles" On="uninstall" Name="*" />
            <RemoveFolder Id="RemoveLogsDir" On="uninstall" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>
    
    <!-- Feature Tree -->
    <Feature Id="ProductFeature" Title="Task Logger" Level="1" 
             Description="The complete Task Logger application"
             Display="expand" AllowAdvertise="no">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="DebugSymbols" />
      <ComponentRef Id="DatabasePathRegistry" />
      <ComponentRef Id="AutoStartEntry" />
      <ComponentRef Id="CleanupUserRegistry" />
      <ComponentRef Id="CleanupDocuments" />
      <ComponentRef Id="CleanupAppData" />
      <ComponentRef Id="CleanupLogs" />
    </Feature>
    
  </Package>
</Wix>
